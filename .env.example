# ===========================================================================
# Vega Queue Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================================================

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string for your Raspberry Pi database.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example (Pi on local network): postgresql://vegabot:strongpassword@192.168.1.50:5432/vega_queue
DATABASE_URL=postgresql://VEGA-QUEUES:your_strong_password@192.168.x.x:5432/Vega_Queue_System_New

# Discord channel ID where the /register command is active.
# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
REGISTRATION_CHANNEL_ID=123456789012345678

# Discord channel ID where the persistent commands list card is posted.
COMMANDS_CHANNEL_ID=123456789012345678

# Discord channel ID where the persistent team creation panel is posted.
TEAM_PANEL_CHANNEL_ID=123456789012345678

# Discord channel ID where the persistent team matchmaking queue panel is posted.
TEAM_QUEUE_CHANNEL_ID=123456789012345678

# (Optional) Discord category ID where private scrim negotiation channels will be created.
# If omitted or 0, channels will be created under the team queue channel's category.
SCRIM_CATEGORY_ID=0

# Comma-separated Discord role IDs for members who can join private team setup threads.
# If omitted, the bot falls back to HELP_ADMIN_ROLE_IDS.
TEAM_MOD_ROLE_IDS=123456789012345678,234567890123456789

# Comma-separated Discord role IDs for admins who should receive private ticket DMs
# and be granted access to help ticket channels.
HELP_ADMIN_ROLE_IDS=123456789012345678,234567890123456789

# ---------------------------------------------------------------------------
# Server B — 10-Man Solo Player Queue (Optional)
# ---------------------------------------------------------------------------
# Discord channel ID where the 10-man solo queue panel is posted in Server B.
SOLO_QUEUE_CHANNEL_ID=123456789012345678

# Discord category ID where private match lobbies (#match-xxx) are created in Server B.
SOLO_MATCH_CATEGORY_ID=123456789012345678

# (Optional) Discord category ID where Team 1 and Team 2 voice channels are created.
SOLO_VOICE_CATEGORY_ID=0

# (Optional) Comma-separated map pool for map veto phase.
MAP_POOL=Ascent, Bind, Haven, Split, Sunset, Lotus, Abyss

# (Optional) Captain selection mode: HIGHEST_ELO (default), RANDOM, FIRST_JOINED, HIGHEST_WINRATE
CAPTAIN_SELECTION_MODE=HIGHEST_ELO

# (Optional) Player draft mode: SNAKE (default), ALTERNATING
DRAFT_MODE=SNAKE

# (Optional) Comma-separated Guild (server) IDs for instant slash-command sync.
# Example: GUILD_IDS=123456789012345678,987654321098765432
# Leave blank for global sync (takes up to 1 hour to propagate to all servers).
GUILD_IDS=

# Discord channel ID where all bot action logs are posted in real-time.
# Every slash command use, invite accept/decline, kick, leave, and disband is logged here.
LOG_CHANNEL_ID=123456789012345678

# ---------------------------------------------------------------------------
# Vision AI — Local Ollama (optional)
# ---------------------------------------------------------------------------
# URL of your Ollama server.
# LOCAL (bot running on same machine as Ollama):
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
# REMOTE (Railway → your PC via tunnel, e.g. Cloudflare Tunnel / ngrok):
#   OLLAMA_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ollama model to use for vision analysis. Must be pulled on your Ollama server.
OLLAMA_MODEL=gemma4:e4b

# (Optional) Comma-separated Discord channel IDs where vision analysis is active.
# Leave blank to allow any channel the bot can see.
VISION_CHANNEL_IDS=

# (Optional) Max image size the bot will accept (in MB). Default: 10
VISION_MAX_IMAGE_MB=10
