# ===========================================================================
# Vega Queue Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ===========================================================================

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_bot_token_here

# PostgreSQL connection string for your Raspberry Pi database.
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Example (Pi on local network): postgresql://vegabot:strongpassword@192.168.1.50:5432/vega_queue
DATABASE_URL=postgresql://VEGA-QUEUES:your_strong_password@192.168.x.x:5432/Vega_Queue_System_New

# Discord channel ID where the /register command is active.
# Right-click the channel in Discord (with Developer Mode on) -> Copy Channel ID.
REGISTRATION_CHANNEL_ID=123456789012345678

# (Optional) Direct video URL to include in the registration info message.
# Discord will auto-preview YouTube links or direct .mp4 URLs.
# Leave blank to omit the video.
REGISTRATION_VIDEO_URL=

# (Optional) Guild (server) ID for instant slash-command sync during development.
# Leave blank for global sync (can take up to 1 hour to propagate).
GUILD_ID=
